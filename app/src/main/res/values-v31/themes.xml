<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Hark.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <!-- "from Thivyan Studios" along the bottom of the splash (Android 12+) -->
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
        <item name="postSplashScreenTheme">@style/Theme.Hark</item>
    </style>
</resources>
